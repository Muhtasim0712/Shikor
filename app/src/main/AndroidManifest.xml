<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CONCEPT: Permissions declaration in AndroidManifest -->
    <!-- Network & Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio Recording & Foreground Service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notifications & Alarms -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Custom Signature Permission for ContentProvider Protection -->
    <!-- CONCEPT: Custom signature-level permission for IPC & Content Provider security -->
    <permission
        android:name="com.shikor.app.permission.READ_FAMILY"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.shikor.app.permission.READ_FAMILY" />

    <application
        android:name=".ShikorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/file_paths"
        android:fullBackupContent="@xml/file_paths"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shikor">

        <!-- CONCEPT: Explicit android:exported on every component -->
        <!-- Launcher: SplashActivity -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Shikor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth & Onboarding Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.FamilySetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard Navigation Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Detail, Person, Story, Tools Activities -->
        <activity
            android:name=".ui.person.PersonDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.person.AddEditPersonActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.story.AddStoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.story.StoryDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tools.RelationshipFinderActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tools.ExportActivity"
            android:exported="false" />

        <!-- CONCEPT: Foreground Service for background elder voice recording -->
        <service
            android:name=".service.AudioRecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- CONCEPT: Manifest-declared Broadcast Receivers -->
        <!-- ReminderReceiver for scheduled birthdays & anniversaries -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ReminderActionReceiver for notification actions ('Call', 'Snooze') -->
        <receiver
            android:name=".receiver.ReminderActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- BootReceiver to reschedule alarms on phone restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- CONCEPT: Custom ContentProvider with signature permission -->
        <provider
            android:name=".provider.FamilyProvider"
            android:authorities="com.shikor.app.provider"
            android:exported="false"
            android:permission="com.shikor.app.permission.READ_FAMILY" />

        <!-- CONCEPT: FileProvider for safe image/PDF/media export sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.shikor.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
