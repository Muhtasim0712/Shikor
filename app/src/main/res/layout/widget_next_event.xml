<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_code_box"
    android:backgroundTint="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header / Widget Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_today" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/widget_today"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Event 1 Row -->
    <LinearLayout
        android:id="@+id/layoutWidgetEvent1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivWidgetAvatar1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_root_avatar_circle"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_my_calendar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_placeholder_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetDetails1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_placeholder_details"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Event 2 Row (Following event if space allows) -->
    <LinearLayout
        android:id="@+id/layoutWidgetEvent2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivWidgetAvatar2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_root_avatar_circle"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_my_calendar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_placeholder_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetDetails2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_placeholder_details"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty / Signed-out State -->
    <TextView
        android:id="@+id/tvWidgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_no_events"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
